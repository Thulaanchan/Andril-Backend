{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ProfilePhotos": {
    "Enabled": false,
    "MaximumUploadBytes": 5242880,
    "MinimumWidth": 300,
    "MinimumHeight": 300,
    "MaximumWidth": 4096,
    "MaximumHeight": 4096,
    "MaximumDecodedPixels": 16777216,
    "MaximumOutputWidth": 1024,
    "MaximumOutputHeight": 1024,
    "JpegQuality": 85,
    "MaximumConcurrentDecodes": 2,
    "CleanupBudgetSeconds": 5,
    "CleanupRetryDelaySeconds": 60,
    "MaximumCleanupCandidates": 4,
    "Storage": { "BucketName": "andril-profile-photos" }
  },
  "ConnectionStrings": {
    "AndrilAccounts": ""
  },
  "SupabaseAuth": {
    "ProjectUrl": "",
    "SigningAlgorithm": "",
    "Audience": "authenticated"
  },
  "Andril": {
    "ProductModules": ["Learning", "Hobbies", "Social"],
    "ApiVersion": "v1"
  }
}
